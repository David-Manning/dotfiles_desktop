
# Print a welcome message and list of aliases
help_zsh()
{
	echo "Help commands for zsh:"
	echo "* source_zsh: sources zshrc"
	echo "* ssh_github: SSH into David-Manning GitHub account"
	echo "* create_github_repo: create repo in GitHub (defaults to private)"
	echo "* hugo_test: create a local Hugo server"
	echo "* shutdown_update: forces updates and shutdown"
	echo "* list_files: lists all files and sizes in current directory"
	echo "* source_zsh: reloads zshrc"
	echo "* latex_compile: compiles a LaTeX file"
	echo "* latex_view: compiles a LaTeX file and opens in Firefox"
	echo "* aws_login_sso: login to AWS account"
	echo "* help_spotify_player: display help commands for spotify_player"
}
