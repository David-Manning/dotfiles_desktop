#----------------------------------------------------------
# SWAY CONFIGURATION - APPEARANCE
#----------------------------------------------------------

# Gaps between windows - only appears on a new workspace
gaps inner 10
smart_gaps off

# Opacity
set $opacity 1
for_window [class=".*"] opacity $opacity
for_window [app_id=".*"] opacity $opacity


# Title bar appearance
font pango:"Roboto Mono Medium" 10
titlebar_border_thickness 1
titlebar_padding 5 2
# client.focused #4c7899 #285577 #ffffff #2e9ef4 #285577

# Waybar calendar popup (launched by ~/.config/waybar/scripts/calendar.sh)
# Position is relative to the workspace, so y=0 is directly under the bar.
# x centres the 300px window on the 3420px workspace (3440 minus gaps).
for_window [title="^waybar-calendar$"] floating enable, border none, sticky enable, move position 1560 px 0 px

